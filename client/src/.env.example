# Live frontend env — Supabase (no local backend needed)
# 1. Create project at https://supabase.com -> Settings -> API -> copy URL + anon key
# 2. SQL Editor -> paste ../../supabase/schema.sql -> Run
# 3. Auth -> Settings -> disable "Confirm email" for dev
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Old backend (no longer needed for the live app, kept for reference)
# VITE_APP_URI_API=http://localhost:5000
